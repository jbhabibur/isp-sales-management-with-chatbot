# ==========================================
# Root & General Exclusions
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
*.tmp
*.bak
*.swp

# Environment & Secret Files (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.cert

# IDEs & Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Frontend: Next.js / Node.js
# ==========================================
# Dependencies (Prevents large file push errors)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js Build & Cache Output
.next/
out/
build/
dist/
.vercel
.turbo

# Testing & Coverage
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/

# TypeScript Cache
*.tsbuildinfo

# Next.js Serverless Function Bundles
.serverless/

# ==========================================
# Backend: Python / FastAPI
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Python Virtual Environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.venv*/

# FastAPI / Uvicorn / Pytest
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.celerydb
celerybeat-schedule

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Database & Supabase / Local Tools
# ==========================================
# Supabase Local CLI / Config outputs (Prevents @supabase/cli binary pushes)
.supabase/
supabase/.temp/

# SQLite / Local DB Dump files
*.sqlite3
*.db
*.sqlite
*.sql
*.dump